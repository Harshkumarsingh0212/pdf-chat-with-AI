{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Install deps",
      "type": "shell",
      "command": "pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Backend: Run (uvicorn)",
      "type": "shell",
      "command": "uvicorn main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/fastapi" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servers" }
    },
    {
      "label": "Frontend: Install deps",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Run (vite dev)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servers" }
    },
    {
      "label": "Run App (backend + frontend)",
      "dependsOn": ["Backend: Run (uvicorn)", "Frontend: Run (vite dev)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
